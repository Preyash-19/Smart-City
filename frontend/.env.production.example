# ==============================================================================
# Smart City AI — Frontend Production Environment Template (Vercel / Cloudflare)
# ==============================================================================
# In your Vercel Project Settings -> Environment Variables:
# Add VITE_API_BASE_URL pointing to your deployed backend origin.
# IMPORTANT: DO NOT include an extra '/api' suffix (the frontend client adds /api automatically).

# Example: If your Render backend is at https://smart-city-backend.onrender.com
VITE_API_BASE_URL=https://your-backend-api.onrender.com

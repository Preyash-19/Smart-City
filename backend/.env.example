# ========================================================
# Smart City AI — Backend Environment Configuration Template
# Copy this file to .env for local deployment.
# ========================================================

# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Neon PostgreSQL Connection URLs
# DATABASE_URL: Pooled connection (port 6543) for runtime API queries
DATABASE_URL=postgresql://neondb_owner:password@ep-pooler.neon.tech/neondb?sslmode=require

# DIRECT_URL: Direct unpooled connection (port 5432) for Prisma migrations
DIRECT_URL=postgresql://neondb_owner:password@ep-direct.neon.tech/neondb?sslmode=require

# External Service Endpoints
AI_ENGINE_URL=http://localhost:8000
APP_URL=http://localhost:5173

# Media & Image Storage Configuration
# Set STORAGE_PROVIDER to 'local' for local disk uploads, or 'cloudinary' for cloud CDN
STORAGE_PROVIDER=local
STORAGE_BASE_URL=http://localhost:5000/uploads

# Cloudinary Credentials (Required only when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=smart-city-complaints

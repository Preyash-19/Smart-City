# ==============================================================================
# Smart City AI — Backend Production Environment Template (Render / Cloud Host)
# ==============================================================================
# In your hosting dashboard (e.g. Render Web Service Environment Variables):
# Add these key-value pairs. DO NOT commit production secrets to Git.

# Server Environment
NODE_ENV=production
PORT=5000

# Security (Generate a strong random string: e.g., run `openssl rand -hex 32` or type a 40+ char secret)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Neon PostgreSQL Database Connections
# DATABASE_URL: POOLED connection string (port 6543) from Neon dashboard for runtime queries
DATABASE_URL=postgresql://neondb_owner:[PASSWORD]@[ENDPOINT]-pooler.c-3.neon.tech/neondb?sslmode=require

# DIRECT_URL: DIRECT connection string (port 5432) from Neon dashboard for Prisma schema migrations
DIRECT_URL=postgresql://neondb_owner:[PASSWORD]@[ENDPOINT].c-3.neon.tech/neondb?sslmode=require

# Frontend Origin URL (Your deployed Vercel frontend URL, e.g., https://smart-city-ai.vercel.app)
APP_URL=https://your-frontend-app.vercel.app

# Python AI Engine Endpoint (Your deployed Hugging Face Space URL, or Render/Local URL)
AI_ENGINE_URL=https://your-ai-engine.hf.space

# Cloud Storage Provider (Use 'cloudinary' in production to survive ephemeral container restarts)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=smart-city-complaints

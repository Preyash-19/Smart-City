generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String       @id @default(uuid())
  name               String
  email              String       @unique
  password           String
  role               Role         @default(CITIZEN)
  department         Department?
  departmentRole     String?      @default("OFFICER") // HEAD, OFFICER, STAFF
  status             String       @default("ACTIVE")  // ACTIVE, INACTIVE, INVITED
  invitationToken    String?      @unique
  invitationExpires  DateTime?
  lastLogin          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt
  complaints         Complaint[]  @relation("CitizenComplaints")
  assignedTasks      Complaint[]  @relation("ContractorTasks")
  officerComplaints  Complaint[]  @relation("OfficerAssignments")
  feedbacks          Feedback[]
  notifications      Notification[]
}

model Complaint {
  id                String          @id @default(uuid())
  title             String
  description       String
  imageUrl          String
  voiceUrl          String?
  latitude          Float
  longitude         Float
  address           String
  status            ComplaintStatus @default(SUBMITTED)
  department        Department      @default(GENERAL)
  priority          Priority        @default(MEDIUM)
  severity          String?         @default("MEDIUM")
  severityScore     Int?            @default(50)
  confidence        Float?          @default(0.85)
  civicRelevance    String?         @default("RELEVANT")
  departmentMatch   String?         @default("MATCH")
  verificationStatus String?        @default("PENDING")
  aiPredictedDept   String?
  aiPredictedIssue  String?
  aiPredictedSeverity String?
  aiExplanation     String?
  aiExplanationHi   String?
  aiExplanationMr   String?
  severityReasons   String?
  modelVersion      String?         @default("v2.1-civic-vision")
  humanVerified     Boolean         @default(false)
  humanRemarks      String?
  aiCategory        String?
  evidenceScore     Int             @default(0)
  aiSummary         String?
  isFake            Boolean         @default(false)
  isDuplicate       Boolean         @default(false)
  reportCount       Int             @default(1)
  masterComplaintId String?
  citizenId         String
  contractorId      String?
  assignedOfficerId String?
  completionImage   String?
  completionRemark  String?
  idempotencyKey    String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  citizen           User            @relation("CitizenComplaints", fields: [citizenId], references: [id])
  contractor        User?           @relation("ContractorTasks", fields: [contractorId], references: [id])
  assignedOfficer   User?           @relation("OfficerAssignments", fields: [assignedOfficerId], references: [id])
  masterComplaint   Complaint?      @relation("CommunityVerification", fields: [masterComplaintId], references: [id])
  childComplaints   Complaint[]     @relation("CommunityVerification")
  feedback          Feedback?
  statusLogs        StatusLog[]
  notifications     Notification[]
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  details     String?
  adminId     String?
  adminName   String?
  targetId    String?
  targetEmail String?
  createdAt   DateTime @default(now())
}

model StatusLog {
  id          String          @id @default(uuid())
  status      ComplaintStatus
  remarks     String?
  createdAt   DateTime        @default(now())
  complaintId String
  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String     @id @default(uuid())
  userId      String
  title       String
  message     String
  type        String     @default("STATUS_UPDATE")
  complaintId String?
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

model Feedback {
  id          String    @id @default(uuid())
  rating      Int
  comments    String?
  createdAt   DateTime  @default(now())
  complaintId String    @unique
  userId      String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CITIZEN
  OFFICER
  CONTRACTOR
  ADMIN
}

enum Department {
  ROAD
  SANITATION
  WATER_SUPPLY
  ELECTRICAL
  DRAINAGE
  TRAFFIC
  GENERAL
  OTHER
}

enum ComplaintStatus {
  SUBMITTED
  AI_PROCESSING
  ROUTED
  OFFICER_REVIEW
  CONTRACTOR_ASSIGNED
  IN_PROGRESS
  RESOLVED
  COMPLETED
  CLOSED
  REJECTED
  DUPLICATE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
